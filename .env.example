APP_NAME=旅行助手
# 兼容 OpenAI 接口的密钥与地址（如 DeepSeek / 通义千问等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# 访问口令：填了之后，调用接口需带请求头 X-Access-Token（留空=不校验）
ACCESS_TOKEN=

# 语义检索 / 重排（本地模型，首次运行会下载，走 HuggingFace 镜像加速）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# 关闭其中任一通道可填 none（如 RERANK_MODEL=none → 只用 RRF 融合排序）
HF_ENDPOINT=https://hf-mirror.com

# 对话日志库 / 缓存（docker-compose 已内置 mysql 与 redis，通常无需改）
# 留空 DATABASE_URL 时回退 SQLite（本地开发零依赖）
# DATABASE_URL=mysql+aiomysql://travel:travel@mysql:3306/travel
# REDIS_URL=redis://redis:6379/0
# MYSQL_PASSWORD=travel

# 可选：国内服务器构建时用镜像源加速（留空则用官方源）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
